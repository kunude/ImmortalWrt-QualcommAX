diff --git a/target/linux/qualcommax/base-files/etc/uci-defaults/991_set-network.sh b/target/linux/qualcommax/base-files/etc/uci-defaults/991_set-network.sh
new file mode 100644
index 0000000000..cd6e601594
--- /dev/null
+++ b/target/linux/qualcommax/base-files/etc/uci-defaults/991_set-network.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+
+# 检查 network.globals.ula_prefix 是否存在且不为空
+ula_prefix=$(uci get network.globals.ula_prefix 2>/dev/null)
+
+if [ -n "$ula_prefix" ]; then
+	uci set dhcp.wan6=dhcp
+	uci set dhcp.wan6.interface='wan6'
+	uci set dhcp.wan6.ignore='1'
+
+	uci set dhcp.lan.force='1'
+	uci set dhcp.lan.ra='hybrid'
+	uci set dhcp.lan.ra_default='1'
+	uci set dhcp.lan.max_preferred_lifetime='1800'
+	uci set dhcp.lan.max_valid_lifetime='3600'
+
+	uci del dhcp.lan.dhcpv6
+	uci del dhcp.lan.ra_flags
+	uci del dhcp.lan.ra_slaac
+	uci add_list dhcp.lan.ra_flags='none'
+
+	uci commit dhcp
+
+	uci set network.wan6.reqaddress='try'
+	uci set network.wan6.reqprefix='auto'
+	uci set network.lan.ip6assign='64'
+	uci set network.lan.ip6ifaceid='eui64'
+	uci set network.globals.packet_steering='0'
+	uci del network.globals.ula_prefix
+
+	uci commit network
+fi
+
+exit 0
diff --git a/target/linux/qualcommax/base-files/etc/uci-defaults/999-QOL_config b/target/linux/qualcommax/base-files/etc/uci-defaults/999-QOL_config
new file mode 100644
index 0000000000..b52da1de4c
--- /dev/null
+++ b/target/linux/qualcommax/base-files/etc/uci-defaults/999-QOL_config
@@ -0,0 +1,39 @@
+# This file ships in the image, so it runs again after every
+# settings-preserving sysupgrade. Apply the opinionated defaults once and
+# record that, or a user who changed any of them gets them silently reset on
+# their next upgrade.
+# The marker lives in uci because /etc/config is preserved across sysupgrade;
+# clear it to have these defaults applied again.
+[ "$(uci -q get system.@system[0].qol_defaults)" = 1 ] && exit 0
+
+uci -q batch << EOI
+
+# Wireless defaults live in the static /etc/config/wireless (configured from
+# the first boot - no detection race - but disabled until the user sets a key).
+
+# Firewall settings
+set firewall.@zone[1].input='DROP'
+
+# Network settings (BCP38 anti-spoofing on WAN).
+set bcp38.cfg018e45.enabled='1'
+set bcp38.cfg018e45.interface='wan'
+
+# NTP: serve time locally (sysntpd) and advertise this router to LAN clients
+# via DHCP option 42 (which carries IP addresses, not hostnames). The address
+# is derived from the live LAN config, not hardcoded.
+set system.ntp.enable_server='1'
+
+# uHTTPd settings
+set uhttpd.main.redirect_https='1'
+
+EOI
+
+# DHCP option 42 needs the router's actual LAN address - derive it from the
+# live config (uci-defaults run after the board defaults exist). add_list does
+# not deduplicate, so check for an existing option 42 first.
+lan_ip=$(uci -q get network.lan.ipaddr)
+[ -n "$lan_ip" ] && ! uci -q get dhcp.lan.dhcp_option | tr ' ' '\n' | grep -q '^42,' \
+	&& uci -q add_list dhcp.lan.dhcp_option="42,${lan_ip%%/*}"
+
+uci -q set system.@system[0].qol_defaults='1'
+exit 0
diff --git a/target/linux/qualcommax/base-files/usr/bin/nss_freq b/target/linux/qualcommax/base-files/usr/bin/nss_freq
new file mode 100644
index 0000000000..70a738ec2f
--- /dev/null
+++ b/target/linux/qualcommax/base-files/usr/bin/nss_freq
@@ -0,0 +1,79 @@
+#!/bin/sh
+
+clock_dir=/proc/sys/dev/nss/clock
+current_freq="$clock_dir/current_freq"
+auto_scale="$clock_dir/auto_scale"
+compatible=/proc/device-tree/compatible
+
+die() {
+	echo "nss_freq: $*" >&2
+	exit 1
+}
+
+format_frequency() {
+	case "$1" in
+		''|*[!0-9]*) echo "Unknown" ;;
+		*) awk -v hz="$1" 'BEGIN { printf "%.1f MHz", hz / 1000000 }' ;;
+	esac
+}
+
+show_status() {
+	status_current="$(cat "$current_freq" 2>/dev/null)" || die "NSS frequency control is unavailable"
+	status_scale="$(cat "$auto_scale" 2>/dev/null)" || die "NSS frequency mode is unavailable"
+	case "$status_scale" in
+		1) status_mode="Auto" ;;
+		0) status_mode="Fixed" ;;
+		*) status_mode="Unknown" ;;
+	esac
+
+	echo "NSS MODE: $status_mode"
+	echo "NSS FREQ: $(format_frequency "$status_current")"
+}
+
+select_frequencies() {
+	[ -r "$compatible" ] || die "device-tree compatible data is unavailable"
+
+	if grep -q 'qcom,ipq6018' "$compatible"; then
+		mid_frequency=748800000
+		high_frequency=1497600000
+	elif grep -q 'qcom,ipq8074' "$compatible"; then
+		mid_frequency=748800000
+		high_frequency=1689600000
+	else
+		die "unsupported platform"
+	fi
+}
+
+save_level() {
+	[ "$(uci -q get nss_freq.settings.level)" = "$level" ] && return
+
+	uci -q set nss_freq.settings=nss_freq || die "failed to save NSS frequency level"
+	uci -q set nss_freq.settings.level="$level" || die "failed to save NSS frequency level"
+	uci -q commit nss_freq || die "failed to save NSS frequency level"
+}
+
+case "${1:-status}" in
+	status)
+		show_status
+		exit 0
+		;;
+	mid|high)
+		level="$1"
+		;;
+	*)
+		echo "Usage: nss_freq {mid|high|status}" >&2
+		exit 2
+		;;
+esac
+
+select_frequencies
+[ -w "$current_freq" ] || die "run as root after the NSS driver has initialized"
+
+case "$level" in
+	mid) target_frequency=$mid_frequency ;;
+	high) target_frequency=$high_frequency ;;
+esac
+
+printf '%s\n' "$target_frequency" > "$current_freq" || die "failed to set NSS frequency"
+save_level
+show_status
