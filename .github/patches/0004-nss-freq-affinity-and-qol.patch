index 0000000000..43795af922
--- /dev/null
+++ b/patches/feeds/edma-nss/luci/0001-status-connections-show-nss-dscp-class.patch
@@ -0,0 +1,52 @@
+luci-mod-status: show the NSS QoS DSCP class on the connections page
+
+The nssqos service records each marked connection's DSCP class in the
+conntrack mark as (dscp | 0x80). getConntrackList already surfaces the
+mark, so decode it into a DSCP column on Status -> Realtime -> Connections.
+This replaces the separate NSS connections viewer the image used to ship.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+--- a/modules/luci-mod-status/htdocs/luci-static/resources/view/status/connections.js
++++ b/modules/luci-mod-status/htdocs/luci-static/resources/view/status/connections.js
+@@ -54,6 +54,22 @@
+ 
+ const recheck_lookup_queue = {};
+ 
++/* NSS QoS (package nssqos) records a connection's DSCP class in the conntrack
++ * mark as (dscp | 0x80), qosmate-compatible. Decode it so accelerated flows
++ * show their class here — the mark rides in the getConntrackList payload. */
++const NSS_DSCP_NAMES = {
++	0:'CS0', 8:'CS1', 16:'CS2', 24:'CS3', 32:'CS4', 40:'CS5', 48:'CS6', 56:'CS7',
++	10:'AF11', 12:'AF12', 14:'AF13', 18:'AF21', 20:'AF22', 22:'AF23',
++	26:'AF31', 28:'AF32', 30:'AF33', 34:'AF41', 36:'AF42', 38:'AF43',
++	46:'EF', 44:'VA', 1:'LE'
++};
++function nssDscpLabel(mark) {
++	const m = +mark || 0;
++	if (!(m & 0x80)) return '-';
++	const d = m & 0x7f;
++	return NSS_DSCP_NAMES[d] || ('0x' + d.toString(16));
++}
++
+ Math.log2 = Math.log2 || function(x) { return Math.log(x) * Math.LOG2E; };
+ 
+ return view.extend({
+@@ -194,7 +210,7 @@
+ 							}
+ 					}
+ 
+-					rows.push([network, protocol, source, destination, transfer]);
++					rows.push([network, protocol, source, destination, transfer, nssDscpLabel(c.mark)]);
+ 			}
+ 
+ 			cbi_update_table('#connections', rows, E('em', _('No information available')));
+@@ -511,7 +527,8 @@
+ 							E('th', { 'class': 'th col-2' }, [ _('Protocol') ]),
+ 							E('th', { 'class': 'th col-7' }, [ _('Source') ]),
+ 							E('th', { 'class': 'th col-7' }, [ _('Destination') ]),
+-							E('th', { 'class': 'th col-4' }, [ _('Transfer') ])
++							E('th', { 'class': 'th col-4' }, [ _('Transfer') ]),
++							E('th', { 'class': 'th col-2' }, [ _('DSCP') ])
+ 						]),
+ 						E('tr', { 'class': 'tr placeholder' }, [
+ 							E('td', { 'class': 'td' }, [
diff --git a/patches/feeds/ppe/packages/0001-sqm-scripts-pin-the-fork-that-carries-hw_ppe.patch b/patches/feeds/ppe/packages/0001-sqm-scripts-pin-the-fork-that-carries-hw_ppe.patch
new file mode 100644
index 0000000000..071db447fc
--- /dev/null
+++ b/patches/feeds/ppe/packages/0001-sqm-scripts-pin-the-fork-that-carries-hw_ppe.patch
@@ -0,0 +1,35 @@
+sqm-scripts: pin the fork that carries the hw_ppe script
+
+hw_ppe.qos drives the PPE port shaper and its bulk queue from the SQM
+config, and exists only in the sqm-scripts fork - upstream sqm-scripts has
+no hardware backend. The pin is the tip of the fork's hw-ppe-offload
+branch, rebased onto upstream v1.8.0 so it carries the nftables marking
+the feed now builds against, and it pairs with the qca_ppe driver on
+ppe-offload: the driver serves priorities eight and up from a
+schedulable band of their own, and the script shapes only the download
+into it, so local traffic between switch ports runs at line rate.
+
+PKG_VERSION names a release upstream has not made, so the fork's tarball
+never shares a download name with the one the unpatched feed fetches.
+
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+--- a/net/sqm-scripts/Makefile
++++ b/net/sqm-scripts/Makefile
+@@ -8,13 +8,13 @@
+ include $(TOPDIR)/rules.mk
+ 
+ PKG_NAME:=sqm-scripts
+-PKG_SOURCE_VERSION:=77cf89e82ced9b215cc02f64fd471f5278b7d031
+-PKG_VERSION:=1.8.0
++PKG_SOURCE_VERSION:=a9c7b6dbd95d9bc652905b7bdd10839c08b2c14e
++PKG_VERSION:=1.8.3
+ PKG_RELEASE:=1
+ 
+ PKG_SOURCE_PROTO:=git
+-PKG_SOURCE_URL:=https://github.com/tohojo/sqm-scripts
+-PKG_MIRROR_HASH:=65322cd90305838d6aab49b433e37b4601b603184bfe2442bee6c996d2bf7ade
++PKG_SOURCE_URL:=https://github.com/JuliusBairaktaris/sqm-scripts
++PKG_MIRROR_HASH:=skip
+ 
+ PKG_MAINTAINER:=Toke Høiland-Jørgensen <toke@toke.dk>
+ PKG_LICENSE:=GPL-2.0-only
