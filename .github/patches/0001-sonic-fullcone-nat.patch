++same_source_endpoint(const struct nf_conntrack_tuple *a,
++		     const struct nf_conntrack_tuple *b)
++{
++	return a->src.l3num == b->src.l3num &&
++	       a->dst.protonum == b->dst.protonum &&
++	       nf_inet_addr_cmp(&a->src.u3, &b->src.u3) &&
++	       a->src.u.all == b->src.u.all;
++}
